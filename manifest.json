{
  "manifest_version": 3,
  "name": "Щогодинний сигнал",
  "version": "1.0.0",
  "description": "Програє обраний звук рівно на початку кожної години — нагадування зробити перерву, випити води, встати з-за компʼютера.",
  "permissions": ["alarms", "storage", "offscreen"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Щогодинний сигнал",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
